<mxfile>
  <diagram id="seqlayout" name="Blind credential flow">
    <mxGraphModel dx="2440" dy="1200" background="#111111" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="tab" value="Response tab&#xa;respond origin · your browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#0f1a2e;strokeColor=#5b8def;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="320" y="150" width="220" height="1070" as="geometry"/>
        </mxCell>
        <mxCell id="popup" value="Claim popup&#xa;portal origin · your browser" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="150" width="220" height="1070" as="geometry"/>
        </mxCell>
        <mxCell id="portal" value="Portal API&#xa;issuer · knows your account" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1140" y="150" width="220" height="1070" as="geometry"/>
        </mxCell>
        <mxCell id="signer" value="Signer&#xa;loopback only · no database" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1550" y="150" width="220" height="1070" as="geometry"/>
        </mxCell>
        <mxCell id="respond" value="Response API&#xa;verifier · no sign-in, no cookies" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;size=40;fillColor=#0f1a2e;strokeColor=#5b8def;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1960" y="150" width="220" height="1070" as="geometry"/>
        </mxCell>
        <mxCell id="act0" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#2a2a2a;strokeColor=#9a9a9a;" vertex="1" parent="signer">
          <mxGeometry x="105" y="430" width="10" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="act1" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#2a2a2a;strokeColor=#9a9a9a;" vertex="1" parent="portal">
          <mxGeometry x="105" y="320" width="10" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="act2" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#2a2a2a;strokeColor=#9a9a9a;" vertex="1" parent="popup">
          <mxGeometry x="105" y="210" width="10" height="430" as="geometry"/>
        </mxCell>
        <mxCell id="act3" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#2a2a2a;strokeColor=#9a9a9a;" vertex="1" parent="respond">
          <mxGeometry x="105" y="750" width="10" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="act4" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;fillColor=#2a2a2a;strokeColor=#9a9a9a;" vertex="1" parent="tab">
          <mxGeometry x="105" y="640" width="10" height="390" as="geometry"/>
        </mxCell>
        <mxCell id="note0" value="secret = 32 random bytes. message = tag ‖ poll ID ‖ key version ‖ secret" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="220" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note1" value="blind(message) → blinded request. Saved as claim_sent before it leaves." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="280" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m2" value="postMessage: blinded request + nonce" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#f2f2f2;fontColor=#e6e6e6;fontSize=12;labelBackgroundColor=#111111;exitX=0.5;exitY=0.1963;entryX=0;entryY=0.0;" edge="1" parent="1" source="tab" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note3" value="Shows your signed-in account and the poll. You confirm once." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="860" y="390" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m4" value="POST /claim {keyId, blindedMessage}" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endSize=8;strokeColor=#d4d4d4;fontColor=#e6e6e6;fontSize=12;labelBackgroundColor=#111111;exitX=1;exitY=0.2558;entryX=0;entryY=0.0;" edge="1" parent="1" source="act2" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note5" value="Eligible? Insert one claim row for your account and commit first." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="500" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m6" value="blind-sign with this poll's key" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endSize=8;strokeColor=#d4d4d4;fontColor=#e6e6e6;fontSize=12;labelBackgroundColor=#111111;exitX=1;exitY=0.5238;entryX=0;entryY=0.0;" edge="1" parent="1" source="act1" target="act0">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m7" value="blind signature" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#9a9a9a;fontColor=#c4c4c4;fontSize=12;labelBackgroundColor=#111111;exitX=0;exitY=1.0;entryX=1;entryY=0.7619;" edge="1" parent="1" source="act0" target="act1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="m8" value="201 {blindSignature}" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#9a9a9a;fontColor=#c4c4c4;fontSize=12;labelBackgroundColor=#111111;exitX=0;exitY=1.0;entryX=1;entryY=0.7442;" edge="1" parent="1" source="act1" target="act2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note9" value="Saw: your account, and that you claimed. Never: the secret, message or final signature." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#2a2110;strokeColor=#f0b14a;fontColor=#f3cf8f;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1270" y="710" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m10" value="postMessage: blind signature" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#f2f2f2;fontColor=#e6e6e6;fontSize=12;labelBackgroundColor=#111111;exitX=0;exitY=1.0;entryX=1;entryY=0.0;" edge="1" parent="1" source="act2" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note11" value="unblind → signature. Verify with the poll's public key. Save as usable." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="820" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m12" value="POST /responses {credential, answers} · credentials: omit" style="html=1;verticalAlign=bottom;endArrow=block;curved=0;rounded=0;endSize=8;strokeColor=#d4d4d4;fontColor=#e6e6e6;fontSize=12;labelBackgroundColor=#111111;exitX=1;exitY=0.2821;entryX=0;entryY=0.0;" edge="1" parent="1" source="act4" target="act3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note13" value="Verify the signature. nullifier = SHA-256(tag ‖ poll ‖ secret). Insert once." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2090" y="930" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="m14" value="201 accepted" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;curved=0;rounded=0;strokeColor=#9a9a9a;fontColor=#c4c4c4;fontSize=12;labelBackgroundColor=#111111;exitX=0;exitY=1.0;entryX=1;entryY=0.5641;" edge="1" parent="1" source="act3" target="act4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="note15" value="Saw: a valid stamp and answers. Cannot tell which claim or account it came from." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#0f1d36;strokeColor=#5b8def;fontColor=#b8d0ff;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="2090" y="1040" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="note16" value="Erase credential and answers. No receipt, no response ID." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="1100" width="350" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="title" value="Blind credential flow · how one poll credential is issued and used" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#f2f2f2;" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1600" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="RFC 9474 blind RSA signatures (RSABSSA-SHA384-PSS-Randomized), a fresh 3072-bit key for every poll. Notes show what each party can and cannot see. Source: SPEC.md §7–§10." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#a3a3a3;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="56" width="2400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="phase-claim" value="&lt;b&gt;1 · Claim&lt;/b&gt;&lt;br&gt;&lt;br&gt;Your browser seals a random secret in a blinded envelope. The portal checks who you are and stamps the envelope without seeing inside.&lt;br&gt;&lt;br&gt;At most one stamp per account per poll." style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#14110b;strokeColor=#f0b14a;fontColor=#f3cf8f;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="210" width="260" height="650" as="geometry" />
        </mxCell>
        <mxCell id="phase-submit" value="&lt;b&gt;2 · Submit&lt;/b&gt;&lt;br&gt;&lt;br&gt;The response service checks the stamp and remembers that this credential was used. It never learns who you are.&lt;br&gt;&lt;br&gt;An identical retry confirms; different answers are refused." style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#0c1220;strokeColor=#5b8def;fontColor=#b8d0ff;fontSize=13;align=left;verticalAlign=top;spacingLeft=14;spacingRight=12;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="20" y="890" width="260" height="310" as="geometry" />
        </mxCell>
        <mxCell id="divider" value="" style="line;strokeWidth=1;dashed=1;html=1;strokeColor=#3a3a3a;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="300" y="870" width="2160" height="10" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
