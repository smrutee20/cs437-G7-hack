<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="credential-states" name="Browser credential states">
    <mxGraphModel dx="1760" dy="740" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1760" pageHeight="740" background="#111111" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Browser credential states · one poll, one browser" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#f2f2f2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Stored per poll in IndexedDB on the response origin and coordinated across tabs with a Web Lock. The server's uniqueness checks stay authoritative. Source: SPEC.md §8, §10." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#a3a3a3;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1660" height="24" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;aspect=fixed;fillColor=#f2f2f2;strokeColor=#f2f2f2;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="prepared" value="&lt;b&gt;prepared&lt;/b&gt;&lt;br&gt;secret, blinded message, unblinding value and draft answers.&lt;br&gt;&lt;font color=&quot;#a3a3a3&quot;&gt;Safe to discard before any request.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#f2f2f2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="180" y="170" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="claim_sent" value="&lt;b&gt;claim_sent&lt;/b&gt;&lt;br&gt;same data, saved and read back before the request leaves.&lt;br&gt;&lt;font color=&quot;#a3a3a3&quot;&gt;Never starts a new claim on its own.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#f2f2f2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="510" y="170" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="usable" value="&lt;b&gt;usable&lt;/b&gt;&lt;br&gt;credential and draft answers.&lt;br&gt;Blinding data erased once the credential is saved and read back." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#f2f2f2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="840" y="170" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="submit_pending" value="&lt;b&gt;submit_pending&lt;/b&gt;&lt;br&gt;credential and the exact answers being sent; editing frozen.&lt;br&gt;&lt;font color=&quot;#a3a3a3&quot;&gt;Uncertain outcome: retry the same saved payload.&lt;/font&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#f2f2f2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1170" y="170" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="accepted" value="&lt;b&gt;accepted&lt;/b&gt;&lt;br&gt;credential, answers and drafts erased, then a generic success screen. No receipt or response ID." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#0f1a2e;strokeColor=#5b8def;strokeWidth=2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1500" y="170" width="210" height="120" as="geometry" />
        </mxCell>

        <mxCell id="claim_uncertain" value="&lt;b&gt;claim_uncertain&lt;/b&gt;&lt;br&gt;No result arrived within the bridge's 2-minute window. Secret and blinding data erased." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1a1010;strokeColor=#ef5350;strokeWidth=2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="390" y="400" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="consumed" value="&lt;b&gt;claim consumed&lt;/b&gt;&lt;br&gt;The claim was recorded but no credential reached this browser. No replacement in this poll." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1a1010;strokeColor=#ef5350;strokeWidth=2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="630" y="400" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="spent" value="&lt;b&gt;spent&lt;/b&gt;&lt;br&gt;This credential already answered with different answers. Credential erased; these answers were not recorded." style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#1a1010;strokeColor=#ef5350;strokeWidth=2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1170" y="400" width="210" height="120" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#3a3a3a;fontColor=#d4d4d4;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="1500" y="400" width="210" height="102" as="geometry" />
        </mxCell>
        <mxCell id="leg-secret" value="" style="rounded=1;html=1;fillColor=#1c1c1c;strokeColor=#f2f2f2;" vertex="1" parent="legend">
          <mxGeometry x="10" y="30" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-secret-t" value="holds secret material" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="27" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-ok" value="" style="rounded=1;html=1;fillColor=#0f1a2e;strokeColor=#5b8def;strokeWidth=2;" vertex="1" parent="legend">
          <mxGeometry x="10" y="54" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-ok-t" value="final: answers recorded" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="51" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-fail" value="" style="rounded=1;html=1;fillColor=#1a1010;strokeColor=#ef5350;strokeWidth=2;" vertex="1" parent="legend">
          <mxGeometry x="10" y="78" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-fail-t" value="final: no response from here" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="75" width="160" height="20" as="geometry" />
        </mxCell>

        <mxCell id="rules" value="&lt;b&gt;Cleanup and safety rules&lt;/b&gt;&lt;br&gt;• If IndexedDB, Web Locks or the read-back fails, refuse to claim and explain why. Never overwrite another tab's prepared or usable credential.&lt;br&gt;• Observed closure, withdrawal, purge or expiry erases unused credentials. 410 poll_closed / poll_withdrawn ends any attempt and erases secret and pending state.&lt;br&gt;• submit_pending is kept for confirmation until 24 h after closing, then erased even if the outcome is unknown. Non-secret final markers expire 7 days after closing.&lt;br&gt;• An invalid credential (400) shows an explanatory failure screen; it never triggers a new signing request. Secrets never go in URLs, cookies, server storage or the clipboard." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="560" width="1670" height="110" as="geometry" />
        </mxCell>

        <!-- forward transitions -->
        <mxCell id="t-start" value="Prepare my&lt;br&gt;credential" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#d4d4d4;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="prepared">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-claim" value="Open claim window;&lt;br&gt;saved first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#d4d4d4;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prepared" target="claim_sent">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-usable" value="blind signature:&lt;br&gt;unblind, verify, save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#d4d4d4;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="claim_sent" target="usable">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-submit" value="Submit: freeze&lt;br&gt;exact answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#d4d4d4;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usable" target="submit_pending">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-accepted" value="201 / 200&lt;br&gt;accepted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#5b8def;fontColor=#b8d0ff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="submit_pending" target="accepted">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- back transitions -->
        <mxCell id="t-retry-claim" value="cancelled, or rejected before the claim was recorded: explicit retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;dashed=1;fontSize=11;labelBackgroundColor=#111111;strokeColor=#a3a3a3;fontColor=#d4d4d4;exitX=0.2381;exitY=0;exitDx=0;exitDy=0;entryX=0.7619;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="claim_sent" target="prepared">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="130" />
              <mxPoint x="340" y="130" />
            </Array>
            <mxPoint x="0" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-fix" value="first attempt rejected before insert: fix answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;dashed=1;fontSize=11;labelBackgroundColor=#111111;strokeColor=#a3a3a3;fontColor=#d4d4d4;exitX=0.2381;exitY=0;exitDx=0;exitDy=0;entryX=0.7619;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="submit_pending" target="usable">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1220" y="130" />
              <mxPoint x="1000" y="130" />
            </Array>
            <mxPoint x="0" y="-14" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- final transitions -->
        <mxCell id="t-uncertain" value="no result within&lt;br&gt;2 minutes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#ef5350;fontColor=#f4a3a1;align=right;exitX=0.1429;exitY=1;exitDx=0;exitDy=0;entryX=0.7143;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="claim_sent" target="claim_uncertain">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-60" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-consumed" value="409 / 503: claim&lt;br&gt;already consumed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#ef5350;fontColor=#f4a3a1;align=left;exitX=0.8571;exitY=1;exitDx=0;exitDy=0;entryX=0.2857;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="claim_sent" target="consumed">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="60" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-spent" value="409 credential_spent&lt;br&gt;(different answers)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#ef5350;fontColor=#f4a3a1;align=left;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="submit_pending" target="spent">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="70" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
