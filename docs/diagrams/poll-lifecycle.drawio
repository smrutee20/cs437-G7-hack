<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="poll-lifecycle" name="Poll lifecycle and locks">
    <mxGraphModel dx="1820" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1820" pageHeight="770" background="#111111" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Poll lifecycle · states, freezes and locks" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#f2f2f2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Closed is final: no reopening, deadline extensions or edits after opening. Deadlines use the database clock; client clocks never authorize anything. Source: SPEC.md §4, §13, §15." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#a3a3a3;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1740" height="24" as="geometry" />
        </mxCell>

        <mxCell id="start" value="" style="ellipse;html=1;aspect=fixed;fillColor=#f2f2f2;strokeColor=#f2f2f2;" vertex="1" parent="1">
          <mxGeometry x="40" y="215" width="30" height="30" as="geometry" />
        </mxCell>

        <mxCell id="draft" value="&lt;b&gt;draft&lt;/b&gt;&lt;br&gt;Owner edits (revision-checked), previews with synthetic answers, or deletes.&lt;br&gt;&lt;font color=&quot;#a3a3a3&quot;&gt;Nothing public. No claims, responses or results.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#d4d4d4;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="170" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="open" value="&lt;b&gt;open&lt;/b&gt;&lt;br&gt;Eligible accounts claim; valid credentials submit. Owner can read the frozen configuration or close early.&lt;br&gt;&lt;font color=&quot;#a3a3a3&quot;&gt;No results and no live counts.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#0f1a2e;strokeColor=#5b8def;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="600" y="170" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="closed" value="&lt;b&gt;closed&lt;/b&gt; (final)&lt;br&gt;Owner reads threshold-gated results. Identical retries can still confirm an earlier response.&lt;br&gt;&lt;font color=&quot;#a3a3a3&quot;&gt;No new claims or responses. Never reopens.&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#f2f2f2;strokeWidth=2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1040" y="170" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="purged" value="&lt;b&gt;purged&lt;/b&gt;&lt;br&gt;Live data deleted. A tombstone (poll ID and purge date only) is kept for one year so a restored backup cannot bring the poll back." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#888888;strokeWidth=2;fontColor=#d4d4d4;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="1480" y="170" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="deleted" value="&lt;b&gt;deleted&lt;/b&gt;&lt;br&gt;Draft and its signing key removed; tombstone written." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#888888;strokeWidth=2;fontColor=#d4d4d4;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="160" y="430" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="withdrawn" value="&lt;b&gt;withdrawn&lt;/b&gt; (invalidated, final)&lt;br&gt;Operator only: key loss or compromise, a restored backup, or an integrity failure. Results and submission confirmations are withheld for good; the public page says the poll was withdrawn." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#1a1010;strokeColor=#ef5350;strokeWidth=2;fontColor=#f2f2f2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingRight=10;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="820" y="430" width="280" height="130" as="geometry" />
        </mxCell>

        <mxCell id="freeze" value="&lt;b&gt;Frozen at opening&lt;/b&gt;&lt;br&gt;Title, description, questions and option IDs/order, the eligibility list, closes_at (10 minutes to 30 days ahead), policy and thresholds, key ID and public key.&lt;br&gt;&lt;br&gt;Enforced by database constraints and triggers as well as application code. The owner can never supply or replace a signing key." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="600" width="660" height="130" as="geometry" />
        </mxCell>
        <mxCell id="locks" value="&lt;b&gt;Locks and ordering&lt;/b&gt;&lt;br&gt;• Same order everywhere: poll row → redeem advisory lock → claim or response row.&lt;br&gt;• Claim and new response: SELECT … FOR SHARE on the poll; check open, not withdrawn and clock_timestamp() &amp;lt; closes_at; hold the lock to commit.&lt;br&gt;• Close or withdraw: exclusive poll lock, which waits for admitted claims and inserts to finish.&lt;br&gt;• Results: take the closure lock and materialize closure before building the snapshot.&lt;br&gt;• Lock waits and transactions ≤ 2 s. Key generation, signature checks and signing happen outside the lock; signing only after the claim commits." style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#555555;fontColor=#d4d4d4;fontSize=12;align=left;verticalAlign=top;spacingLeft=16;spacingRight=16;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="740" y="600" width="1020" height="130" as="geometry" />
        </mxCell>

        <!-- transitions -->
        <mxCell id="t-create" value="create: fresh&lt;br&gt;RSA-3072 key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#d4d4d4;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="draft">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-open" value="owner opens:&lt;br&gt;everything freezes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#d4d4d4;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="draft" target="open">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-close" value="deadline (DB clock)&lt;br&gt;or owner closes early" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#d4d4d4;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="open" target="closed">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-purge" value="7 days: eligibility, claims&lt;br&gt;90 days: everything else" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#888888;fontColor=#d4d4d4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="closed" target="purged">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-26" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-delete" value="owner deletes, or&lt;br&gt;30 days unedited" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#888888;fontColor=#d4d4d4;align=left;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="draft" target="deleted">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="70" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-withdraw-open" value="operator&lt;br&gt;withdraws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#ef5350;fontColor=#f4a3a1;align=right;exitX=0.9286;exitY=1;exitDx=0;exitDy=0;entryX=0.1429;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="open" target="withdrawn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="-50" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-withdraw-closed" value="operator&lt;br&gt;withdraws" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#ef5350;fontColor=#f4a3a1;align=left;exitX=0.0714;exitY=1;exitDx=0;exitDy=0;entryX=0.8571;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="closed" target="withdrawn">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="50" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t-withdrawn-purge" value="after retention" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#888888;fontColor=#d4d4d4;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="withdrawn" target="purged">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1620" y="495" />
            </Array>
            <mxPoint x="0" y="-12" as="offset" />
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
