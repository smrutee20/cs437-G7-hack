        <mxCell id="leg-anon" value="" style="rounded=0;html=1;fillColor=#0f1a2e;strokeColor=#5b8def;" vertex="1" parent="legend">
          <mxGeometry x="10" y="54" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-anon-t" value="Anonymous side: sees answers" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="51" width="190" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-browser" value="" style="rounded=0;html=1;fillColor=#1c1c1c;strokeColor=#f2f2f2;" vertex="1" parent="legend">
          <mxGeometry x="10" y="78" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-browser-t" value="Your browser" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="75" width="190" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-shared" value="" style="rounded=0;html=1;fillColor=#1c1c1c;strokeColor=#888888;" vertex="1" parent="legend">
          <mxGeometry x="10" y="102" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-shared-t" value="Shared, trusted infrastructure" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="99" width="190" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-ext" value="" style="rounded=0;dashed=1;html=1;fillColor=#161616;strokeColor=#888888;" vertex="1" parent="legend">
          <mxGeometry x="10" y="126" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-ext-t" value="External or isolated service" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="123" width="190" height="20" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-organiser-api" value="HTTPS · session + CSRF" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#f0b14a;fontColor=#f3cf8f;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.1143;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="organiser" target="portal-api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-popup-api" value="POST claim: blinded request&lt;br&gt;(session + CSRF)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#f0b14a;fontColor=#f3cf8f;align=left;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.6429;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="popup" target="portal-api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-tab-api" value="POST response:&lt;br&gt;{credential, answers}" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#5b8def;fontColor=#b8d0ff;align=left;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tab" target="respond-api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="75" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-postmessage" value="postMessage (exact origins, nonce)&lt;br&gt;blinded request ⇄ blind signature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;startArrow=block;startSize=8;dashed=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#141414;strokeColor=#f2f2f2;fontColor=#e6e6e6;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="popup" target="tab">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-28" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-api-signer" value="blinded request + poll key&lt;br&gt;→ blind signature" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#14110b;strokeColor=#f0b14a;fontColor=#f3cf8f;align=left;exitX=0.2429;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal-api" target="signer">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="80" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-keys-api" value="per-poll private key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#14110b;strokeColor=#f0b14a;fontColor=#f3cf8f;align=left;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.6143;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="keys" target="portal-api">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="65" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-api-google" value="OIDC code flow&lt;br&gt;(server-side, PKCE)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;startArrow=block;startSize=8;dashed=1;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#888888;fontColor=#d4d4d4;align=left;exitX=0.0286;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal-api" target="google">
          <mxGeometry x="0.4" relative="1" as="geometry">
            <mxPoint x="70" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-api-identity" value="eligibility, sessions,&lt;br&gt;one claim per account" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#f0b14a;fontColor=#f3cf8f;align=right;exitX=0.8857;exitY=1;exitDx=0;exitDy=0;entryX=0.9444;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal-api" target="schema-identity">
          <mxGeometry x="0.4" relative="1" as="geometry">
            <mxPoint x="-80" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-api-polls" value="drafts, open / close,&lt;br&gt;public keys" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#bbbbbb;fontColor=#d4d4d4;align=left;exitX=0.9857;exitY=1;exitDx=0;exitDy=0;entryX=0.0588;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="portal-api" target="schema-polls">
          <mxGeometry x="0.4" relative="1" as="geometry">
            <mxPoint x="75" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-respond-polls" value="public poll + key" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#bbbbbb;fontColor=#d4d4d4;align=left;exitX=0.2105;exitY=1;exitDx=0;exitDy=0;entryX=0.7353;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="respond-api" target="schema-polls">
          <mxGeometry x="0.4" relative="1" as="geometry">
            <mxPoint x="60" y="0" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e-respond-anon" value="redeem once:&lt;br&gt;nullifier + answers" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endSize=8;strokeWidth=1.5;fontSize=11;labelBackgroundColor=#111111;strokeColor=#5b8def;fontColor=#b8d0ff;align=left;exitX=0.8947;exitY=1;exitDx=0;exitDy=0;entryX=0.3023;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="respond-api" target="schema-anonymous">
