        <mxCell id="leg-identity" value="" style="rounded=0;html=1;fillColor=#1f1a10;strokeColor=#f0b14a;" vertex="1" parent="legend">
          <mxGeometry x="10" y="30" width="28" height="14" as="geometry" />
        </mxCell>
        <mxCell id="leg-identity-t" value="Identity side: knows who you are" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#d4d4d4;" vertex="1" parent="legend">
          <mxGeometry x="46" y="27" width="190" height="20" as="geometry" />
