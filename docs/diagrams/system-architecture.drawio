<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram id="system-architecture" name="System architecture">
    <mxGraphModel dx="1640" dy="1180" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1180" background="#111111" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="IITGN Feedback · system architecture and trust boundaries" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#f2f2f2;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Two HTTPS origins. The identity side knows who you are; the anonymous side sees answers. They share only the poll ID. Source: SPEC.md §6, §8, §12, §14." style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#a3a3a3;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="54" width="1500" height="24" as="geometry" />
        </mxCell>

        <!-- Organiser browser -->
        <mxCell id="organiser" value="&lt;b&gt;Organiser's browser&lt;/b&gt;&lt;br&gt;portal app: drafts, eligibility list,&lt;br&gt;open / close, results" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#d4d4d4;fontColor=#f2f2f2;fontSize=12;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="240" height="120" as="geometry" />
        </mxCell>

        <!-- Participant browser -->
        <mxCell id="browser" value="Participant's browser · desktop Chrome or Firefox" style="swimlane;startSize=34;html=1;rounded=1;arcSize=3;fillColor=#1c1c1c;swimlaneFillColor=#141414;strokeColor=#f2f2f2;fontColor=#f2f2f2;fontSize=14;fontStyle=1;align=left;spacingLeft=14;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="90" width="1280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="popup" value="&lt;b&gt;Claim popup&lt;/b&gt; · portal origin&lt;br&gt;shows your signed-in account + poll,&lt;br&gt;forwards only the blinded request" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="browser">
          <mxGeometry x="40" y="54" width="340" height="126" as="geometry" />
        </mxCell>
        <mxCell id="tab" value="&lt;b&gt;Response tab&lt;/b&gt; · respond origin&lt;br&gt;makes the secret, blinds it, unblinds and&lt;br&gt;verifies the stamp, keeps the credential&lt;br&gt;in IndexedDB until it is used" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0f1a2e;strokeColor=#5b8def;fontColor=#f2f2f2;fontSize=12;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="browser">
          <mxGeometry x="600" y="54" width="380" height="126" as="geometry" />
        </mxCell>
        <mxCell id="browsernote" value="Secrets never go in URLs, cookies, server storage or the clipboard. After a confirmed submission the credential and answers are erased." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#555555;fontColor=#b5b5b5;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="browser">
          <mxGeometry x="1010" y="54" width="250" height="126" as="geometry" />
        </mxCell>

        <!-- Identity side -->
        <mxCell id="zone-identity" value="Identity side · portal.feedback.example" style="swimlane;startSize=34;html=1;rounded=1;arcSize=3;fillColor=#2a2110;swimlaneFillColor=#14110b;strokeColor=#f0b14a;fontColor=#f3cf8f;fontSize=14;fontStyle=1;align=left;spacingLeft=150;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="360" width="780" height="360" as="geometry" />
        </mxCell>
        <mxCell id="portal-api" value="&lt;b&gt;Portal API&lt;/b&gt; · Node 24, Fastify&lt;br&gt;Google sign-in, sessions + CSRF, organiser routes.&lt;br&gt;Issuer: checks eligibility, records one claim per account, then asks the signer." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="zone-identity">
          <mxGeometry x="40" y="54" width="700" height="96" as="geometry" />
        </mxCell>
        <mxCell id="signer" value="&lt;b&gt;Native RSA signer&lt;/b&gt; · workerd&lt;br&gt;loopback only, no database access.&lt;br&gt;Blind-signs; never sees the message." style="rounded=1;arcSize=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="zone-identity">
          <mxGeometry x="80" y="214" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="keys" value="&lt;b&gt;Encrypted key volume&lt;/b&gt;&lt;br&gt;one RSA-3072 key per poll,&lt;br&gt;destroyed within 24 h of closing" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="zone-identity">
          <mxGeometry x="360" y="214" width="220" height="110" as="geometry" />
        </mxCell>

        <!-- Anonymous side -->
        <mxCell id="zone-anonymous" value="Anonymous side · respond.feedback.example" style="swimlane;startSize=34;html=1;rounded=1;arcSize=3;fillColor=#0f1d36;swimlaneFillColor=#0c1220;strokeColor=#5b8def;fontColor=#b8d0ff;fontSize=14;fontStyle=1;align=right;spacingRight=16;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="880" y="360" width="720" height="360" as="geometry" />
        </mxCell>
        <mxCell id="respond-api" value="&lt;b&gt;Response API&lt;/b&gt; · Node 24, Fastify&lt;br&gt;public poll + key, verifies the stamp,&lt;br&gt;stores each credential's answers once.&lt;br&gt;No cookies, no sign-in." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#0f1a2e;strokeColor=#5b8def;fontColor=#f2f2f2;fontSize=12;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="zone-anonymous">
          <mxGeometry x="40" y="54" width="380" height="96" as="geometry" />
        </mxCell>
        <mxCell id="ingress" value="&lt;b&gt;Ingress&lt;/b&gt; strips cookies, Authorization, IP-forwarding, User-Agent and trace headers. No access logs. Rate limits are keyed by route or poll, never by person." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#555555;fontColor=#b5b5b5;fontSize=12;align=left;spacingLeft=10;spacingRight=10;" vertex="1" parent="zone-anonymous">
          <mxGeometry x="440" y="54" width="250" height="150" as="geometry" />
        </mxCell>

        <!-- External identity provider -->
        <mxCell id="google" value="&lt;b&gt;Google OIDC&lt;/b&gt;&lt;br&gt;iitgn.ac.in Workspace accounts&lt;br&gt;(signed hd claim checked)" style="rounded=1;arcSize=8;dashed=1;whiteSpace=wrap;html=1;fillColor=#161616;strokeColor=#888888;fontColor=#d4d4d4;fontSize=12;align=left;spacingLeft=12;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="880" width="240" height="110" as="geometry" />
        </mxCell>

        <!-- Database -->
        <mxCell id="db" value="PostgreSQL 17 · separate schemas + roles" style="swimlane;startSize=34;html=1;rounded=1;arcSize=3;fillColor=#1c1c1c;swimlaneFillColor=#121212;strokeColor=#777777;fontColor=#e6e6e6;fontSize=14;fontStyle=1;align=left;spacingLeft=14;container=1;collapsible=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="320" y="820" width="1280" height="290" as="geometry" />
        </mxCell>
        <mxCell id="schema-identity" value="&lt;b&gt;identity.*&lt;/b&gt;&lt;br&gt;users (issuer, subject) · sessions&lt;br&gt;eligibility: exact emails per poll&lt;br&gt;claims: (poll, user, entry), nothing else" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1f1a10;strokeColor=#f0b14a;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="db">
          <mxGeometry x="40" y="60" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="schema-polls" value="&lt;b&gt;polls · signing_keys&lt;/b&gt;&lt;br&gt;frozen questions, deadline, policy&lt;br&gt;public key only; private keys&lt;br&gt;stay on the key volume" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#1c1c1c;strokeColor=#888888;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="db">
          <mxGeometry x="430" y="60" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="schema-anonymous" value="&lt;b&gt;anonymous.*&lt;/b&gt;&lt;br&gt;responses: (poll, nullifier, answers)&lt;br&gt;no account, IP, user-agent or time&lt;br&gt;result snapshots: after closing, ≥ 5 responses,&lt;br&gt;read only through an owner-gated function" style="shape=cylinder3;size=12;boundedLbl=1;whiteSpace=wrap;html=1;fillColor=#0f1a2e;strokeColor=#5b8def;fontColor=#f2f2f2;fontSize=12;" vertex="1" parent="db">
          <mxGeometry x="810" y="60" width="430" height="190" as="geometry" />
        </mxCell>

        <mxCell id="footer" value="The only value both sides share is the poll ID. Claim rows hold no credential material and response rows hold no account, IP address, user-agent or timestamp, so there is no respondent-level join (SPEC.md §1, §12)." style="text;html=1;align=left;verticalAlign=top;fontSize=12;fontColor=#a3a3a3;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="320" y="1120" width="1280" height="40" as="geometry" />
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#141414;strokeColor=#3a3a3a;fontColor=#d4d4d4;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=10;container=1;collapsible=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1010" width="240" height="150" as="geometry" />
