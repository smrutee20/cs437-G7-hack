{
  "name": "iitgn-feedback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit --project tsconfig.json",
    "build": "npm run build --workspaces --if-present",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:browser": "playwright test",
    "test": "npm run test:unit && npm run test:signer && npm run test:db && npm run test:browser",
    "test:signer": "vitest run --config vitest.signer.config.ts",
    "demo:api": "npm run build && node services/portal-api/dev/demo.mjs",
    "ops": "node services/portal-api/dist/ops-cli.js",
    "test:demo-browser": "npm run build && playwright test -c playwright.demo.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.1.0",
    "rolldown": "1.2.16"
  }
}
